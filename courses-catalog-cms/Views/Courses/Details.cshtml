@model courses_catalog_cms.Models.Course

@{
    ViewData["Title"] = "Szczegóły Kursu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-info"><i class="bi bi-info-circle-fill me-2"></i>Szczegóły Wpisu</h2>
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Wróć do listy
                </a>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 250px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-light d-flex justify-content-center align-items-center" style="height: 250px;">
                        <span class="text-muted"><i class="bi bi-image fs-1 d-block text-center mb-2"></i>Brak zdjęcia</span>
                    </div>
                }

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 mb-2">
                                @Model.Category?.Name
                            </span>
                            <h3 class="fw-bold text-dark mb-0">@Model.Title</h3>
                        </div>
                        <h3 class="fw-bold text-success mb-0">@Model.Price.ToString("C")</h3>
                    </div>

                    <div class="bg-light rounded-3 p-4 border mb-4">
                        <h6 class="fw-bold text-muted text-uppercase mb-3" style="font-size: 0.85rem;">Opis kursu</h6>
                        <p class="text-secondary mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>

                    <div class="d-flex align-items-center p-3 border rounded-3 bg-white">
                        @if (!string.IsNullOrEmpty(Model.Trainer?.ImageUrl))
                        {
                            <img src="@Model.Trainer.ImageUrl" alt="@Model.Trainer.FullName" class="rounded-circle me-3 shadow-sm" style="width: 45px; height: 45px; object-fit: cover; border: 2px solid #e5e7eb;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                        }
                        <div>
                            <h6 class="fw-bold text-muted text-uppercase mb-0" style="font-size: 0.75rem;">Prowadzący</h6>
                            <span class="fw-bold text-dark fs-5">@Model.Trainer?.FullName</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top p-4 d-flex gap-3">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-medium flex-grow-1 shadow-sm">
                        <i class="bi bi-pencil-fill me-2"></i> Edytuj ten kurs
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-outline-danger fw-medium px-4 shadow-sm">
                        <i class="bi bi-trash-fill me-2"></i> Usuń
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>