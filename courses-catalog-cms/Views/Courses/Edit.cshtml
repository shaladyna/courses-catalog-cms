@model courses_catalog_cms.Models.Course

@{
    ViewData["Title"] = "Edycja Kursu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Edycja Kursu</h2>
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Wróć do listy
                </a>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="form-group mb-4">
                            <label asp-for="Title" class="form-label fw-bold text-muted">Tytuł kursu</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-light" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-muted">Opis kursu</label>
                            <textarea asp-for="Description" class="form-control bg-light" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label asp-for="Price" class="form-label fw-bold text-muted">Cena (PLN)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-currency-dollar text-success"></i></span>
                                    <input asp-for="Price" class="form-control bg-light" type="text" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 form-group mb-4">
                                <label asp-for="CategoryId" class="form-label fw-bold text-muted">Kategoria</label>
                                <select asp-for="CategoryId" class="form-select bg-light" asp-items="ViewBag.CategoryId"></select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="TrainerId" class="form-label fw-bold text-muted">Prowadzący</label>

                            <select asp-for="TrainerId" id="trainerSelect" class="form-select bg-light">
                                <option value="">-- Wybierz trenera --</option>
                                @if (ViewBag.Trainers != null)
                                {
                                    @foreach (var trainer in (IEnumerable<courses_catalog_cms.Models.Trainer>)ViewBag.Trainers)
                                    {
                                        <option value="@trainer.Id" data-bio="@trainer.Bio" data-img="@trainer.ImageUrl">@trainer.FullName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger"></span>

                            <div id="trainerPreviewCard" class="mt-3 p-3 bg-white border rounded-3 d-none shadow-sm animate__animated animate__fadeIn" style="border-left: 4px solid #4f46e5 !important;">
                                <div class="d-flex align-items-center">
                                    <img id="previewImg" src="" class="rounded-circle me-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover; display: none;" />
                                    <div id="previewIcon" class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary me-3" style="width: 50px; height: 50px;">
                                        <i class="bi bi-person-fill fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark mb-1" id="previewName"></h6>
                                        <p class="text-muted small mb-0" id="previewBio" style="font-style: italic; line-height: 1.4;"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mb-5 p-4 bg-light rounded-3 border">
                            <label class="form-label fw-bold text-dark">Miniaturka kursu</label>

                            <div class="d-flex align-items-center gap-4 mt-2">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="Obecna grafika" class="rounded-3 shadow-sm" style="width: 120px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-white rounded-3 border d-flex align-items-center justify-content-center text-muted" style="width: 120px; height: 80px;">
                                        <i class="bi bi-image fs-3"></i>
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <label for="imageFile" class="form-label small text-muted mb-1">Zmień grafikę (zostaw puste, aby zachować obecną)</label>
                                    <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                                <i class="bi bi-save me-2"></i> Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function updateTrainerPreview() {
            var select = document.getElementById('trainerSelect');
            var selectedOption = select.options[select.selectedIndex];
            var card = document.getElementById('trainerPreviewCard');

            if (!selectedOption || !selectedOption.value) {
                card.classList.add('d-none');
                return;
            }

            var name = selectedOption.text;
            var bio = selectedOption.getAttribute('data-bio') || 'Brak biogramu prowadzącego.';
            var img = selectedOption.getAttribute('data-img');

            document.getElementById('previewName').innerText = name;
            document.getElementById('previewBio').innerText = bio;

            var imgEl = document.getElementById('previewImg');
            var iconEl = document.getElementById('previewIcon');

            if (img && img !== "") {
                imgEl.src = img;
                imgEl.style.display = 'block';
                iconEl.style.display = 'none';
            } else {
                imgEl.style.display = 'none';
                iconEl.style.display = 'flex';
            }

            card.classList.remove('d-none');
        }

        // Słuchaj zmian w dropdownie
        document.getElementById('trainerSelect').addEventListener('change', updateTrainerPreview);

        // WYWOŁANIE NA STARCE (Dla Edycji) - uruchomi podgląd od razu po wczytaniu danych z bazy
        window.addEventListener('DOMContentLoaded', updateTrainerPreview);
    </script>
}