@model IEnumerable<courses_catalog_cms.Models.Course>

@{
    ViewData["Title"] = "Zarządzanie Kursami";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i> Baza Kursów</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-medium">
            <i class="bi bi-plus-lg me-1"></i> Dodaj nowy kurs
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted">Miniaturka</th>
                            <th class="px-4 py-3 text-muted">Tytuł kursu</th>
                            <th class="px-4 py-3 text-muted">Kategoria</th>
                            <th class="px-4 py-3 text-muted">Prowadzący</th>
                            <th class="px-4 py-3 text-muted">Cena</th>
                            <th class="px-4 py-3 text-muted text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="Miniaturka" class="rounded-3 shadow-sm" style="width: 80px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-secondary shadow-sm" style="width: 80px; height: 50px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="px-4 fw-bold text-dark">
                                    @item.Title
                                </td>
                                <td class="px-4">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                        @item.Category?.Name
                                    </span>
                                </td>
                                <td class="px-4 text-secondary">
                                    @item.Trainer?.FullName
                                </td>
                                <td class="px-4 fw-bold text-success">
                                    @item.Price.ToString("C")
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-medium px-3">Edytuj</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info fw-medium px-3">Szczegóły</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger fw-medium px-3">Usuń</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center p-5">
                    <h5 class="text-muted">Brak kursów w bazie.</h5>
                </div>
            }
        </div>
    </div>
</div>