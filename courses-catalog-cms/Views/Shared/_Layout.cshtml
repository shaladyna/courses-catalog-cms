<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - courses_catalog_cms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/courses_catalog_cms.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2280%22>🎓</text></svg>">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-0 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                    <span>EduCatalog CMS</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Przeglądaj kursy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <span class="text-muted small">Witaj, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-gear-fill"></i> Panel Admina
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-danger btn-sm" asp-area="" asp-controller="Account" asp-action="Logout">Wyloguj</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary px-4" asp-area="" asp-controller="Account" asp-action="Login">Zaloguj się</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="d-flex align-items-center gap-2">
                        <i class="bi bi-mortarboard-fill text-primary"></i> EduCatalog CMS
                    </h5>
                    <p class="small mb-3 opacity-75" style="line-height: 1.6;">
                        Nowoczesna platforma edukacyjna łącząca pasjonatów wiedzy z najlepszymi ekspertami w branży. Ucz się we własnym tempie.
                    </p>
                </div>

                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5>Szybkie linki</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Przeglądaj kursy</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a></li>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li><a asp-area="" asp-controller="Account" asp-action="Login">Zaloguj do systemu</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h5>Kontakt</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small opacity-75">
                        <li><i class="bi bi-envelope-fill me-2 text-primary"></i> kontakt@educatalog.pl</li>
                        <li><i class="bi bi-telephone-fill me-2 text-primary"></i> +48 123 456 789</li>
                        <li><i class="bi bi-geo-alt-fill me-2 text-primary"></i> ul. Akademicka 1, 00-000 Warszawa</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom text-center opacity-50">
                &copy; 2026 - EduCatalog CMS. Projekt zrealizowany w ramach zaliczenia.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
