@{
    ViewData["Title"] = "Panel Administratora";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-speedometer2 text-primary me-2"></i> Kokpit Zarządzania</h2>
            <span class="text-muted">Witaj, @User.Identity.Name! Oto podsumowanie Twojego systemu.</span>
        </div>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden" style="background: linear-gradient(145deg, #ffffff, #f3f4f6);">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Aktywne kursy</h6>
                        <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.CoursesCount</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-journal-bookmark-fill fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary w-100 fw-medium shadow-sm">Zarządzaj kursami</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden" style="background: linear-gradient(145deg, #ffffff, #f3f4f6);">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Kategorie</h6>
                        <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.CategoriesCount</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-tags-fill fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-success w-100 fw-medium shadow-sm">Zarządzaj kategoriami</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden" style="background: linear-gradient(145deg, #ffffff, #f3f4f6);">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold mb-1">Trenerzy</h6>
                        <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.TrainersCount</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-person-badge-fill fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                    <a asp-controller="Trainers" asp-action="Index" class="btn btn-warning text-dark w-100 fw-medium shadow-sm">Zarządzaj trenerami</a>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center rounded-4 p-4" role="alert">
        <i class="bi bi-info-circle-fill fs-3 me-3 text-info"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">Wskazówka systemowa</h5>
            <p class="mb-0 text-muted">Pamiętaj, aby przy usuwaniu kategorii upewnić się, że nie ma do niej przypisanych żadnych aktywnych kursów, w przeciwnym razie system może zwrócić błąd relacji w bazie danych.</p>
        </div>
    </div>
</div>