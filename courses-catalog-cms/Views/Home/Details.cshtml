@model courses_catalog_cms.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm mb-4" alt="@Model.Title" style="width: 100%; max-height: 450px; object-fit: cover;">
            }
            else
            {
                <img src="https://via.placeholder.com/800x450?text=Brak+zdjęcia" class="img-fluid rounded-4 shadow-sm mb-4" alt="Brak zdjęcia" style="width: 100%;">
            }

            <span class="badge bg-primary mb-3 fs-6">@Model.Category?.Name</span>
            <h1 class="fw-bold mb-4 text-dark">@Model.Title</h1>

            <h4 class="fw-semibold mb-3">O czym jest ten kurs?</h4>
            <div class="fs-5 text-secondary" style="line-height: 1.8; white-space: pre-wrap;">
                @Model.Description
            </div>
        </div>

        <div class="col-lg-4 mt-5 mt-lg-0">
            <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px; z-index: 1;">
                <div class="card-body p-4">
                    <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.85rem;">Cena</p>
                    <h2 class="fw-bold text-success mb-4">@Model.Price.ToString("C")</h2>

                    <button class="btn btn-primary btn-lg w-100 mb-3 fw-bold shadow-sm">
                        <i class="bi bi-cart-plus-fill me-2"></i> Zapisz się na kurs
                    </button>
                    <p class="small text-muted text-center mb-4"><i class="bi bi-shield-lock-fill text-success"></i> Gwarancja satysfakcji lub zwrot pieniędzy</p>

                    <hr class="mb-4" />

                    <h5 class="fw-bold mb-3">Twój prowadzący:</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-primary shadow-sm" style="width: 55px; height: 55px;">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-0 fw-bold fs-5 text-dark">@Model.Trainer?.FullName</h6>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Trainer?.Bio))
                    {
                        <div class="small text-muted p-3 bg-light rounded-3 mt-2" style="font-style: italic;">
                            "@Model.Trainer.Bio"
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a asp-action="Index" class="btn btn-outline-secondary fw-medium px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i> Wróć do przeglądania oferty
        </a>
    </div>
</div>