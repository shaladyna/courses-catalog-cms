@model courses_catalog_cms.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm mb-4" alt="@Model.Title" style="width: 100%; max-height: 450px; object-fit: cover;">
            }
            else
            {
                <img src="https://via.placeholder.com/800x450?text=Brak+zdjęcia" class="img-fluid rounded-4 shadow-sm mb-4" alt="Brak zdjęcia" style="width: 100%;">
            }

            <span class="badge bg-primary mb-3 fs-6 px-3 py-2">@Model.Category?.Name</span>
            <h1 class="fw-bold mb-4 text-dark">@Model.Title</h1>

            <h4 class="fw-semibold mb-3 mt-5">O czym jest ten kurs?</h4>
            <div class="fs-5 text-secondary" style="line-height: 1.8; white-space: pre-wrap;">@Model.Description</div>

            <hr class="my-5 opacity-25" id="trainer-bio" />

            <h4 class="fw-bold mb-4">Twój prowadzący</h4>
            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4 bg-light p-4 rounded-4 shadow-sm mb-5">
                @if (!string.IsNullOrEmpty(Model.Trainer?.ImageUrl))
                {
                    <img src="@Model.Trainer.ImageUrl" alt="@Model.Trainer.FullName" class="rounded-circle shadow-sm flex-shrink-0" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #4f46e5;" />
                }
                else
                {
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center text-primary shadow-sm flex-shrink-0" style="width: 120px; height: 120px; border: 3px solid #4f46e5;">
                        <i class="bi bi-person-fill" style="font-size: 4rem;"></i>
                    </div>
                }

                <div class="text-center text-sm-start">
                    <h5 class="fw-bold mb-2 fs-4 text-dark">@Model.Trainer?.FullName</h5>
                    @if (!string.IsNullOrEmpty(Model.Trainer?.Bio))
                    {
                        <p class="text-secondary mb-0" style="line-height: 1.6;">
                            @Model.Trainer.Bio
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4 mt-5 mt-lg-0">
            <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px; z-index: 1;">
                <div class="card-body p-4 p-lg-5">
                    <p class="text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.85rem;">Cena kursu</p>
                    <h2 class="fw-bold text-success display-6 mb-4">@Model.Price.ToString("C")</h2>

                    <button class="btn btn-primary btn-lg w-100 py-3 mb-3 fw-bold shadow-sm">
                        <i class="bi bi-cart-plus-fill me-2"></i> Zapisz się na kurs
                    </button>
                    <p class="small text-muted text-center mb-4"><i class="bi bi-shield-lock-fill text-success"></i> Gwarancja satysfakcji lub zwrot pieniędzy</p>

                    <hr class="mb-4 opacity-25" />

                    <p class="text-muted mb-3 text-uppercase fw-bold" style="font-size: 0.85rem;">Prowadzący</p>
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.Trainer?.ImageUrl))
                        {
                            <img src="@Model.Trainer.ImageUrl" alt="@Model.Trainer.FullName" class="rounded-circle shadow-sm" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #4f46e5;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-primary shadow-sm" style="width: 50px; height: 50px;">
                                <i class="bi bi-person-fill fs-3"></i>
                            </div>
                        }
                        <div class="ms-3">
                            <h6 class="mb-0 fw-bold fs-6 text-dark">@Model.Trainer?.FullName</h6>
                            <a href="#trainer-bio" class="text-decoration-none small text-primary fw-medium" onclick="document.getElementById('trainer-bio').scrollIntoView({ behavior: 'smooth' }); return false;">
                                Zobacz pełny profil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-4 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary fw-medium px-4 py-2 rounded-pill">
            <i class="bi bi-arrow-left me-2"></i> Wróć do przeglądania oferty
        </a>
    </div>
</div>