@model IEnumerable<courses_catalog_cms.Models.Course>

@{
    ViewData["Title"] = "Najlepsze kursy w sieci";
}

<div class="p-5 text-center bg-image rounded-3 mb-5" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: white; padding-top: 80px !important; padding-bottom: 80px !important; margin-top: -16px; margin-left: -15px; margin-right: -15px; border-radius: 0 !important;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Zainwestuj w swoją przyszłość</h1>
        <p class="lead fs-4 mb-0 opacity-75">Odkryj setki kursów prowadzonych przez ekspertów z branży.</p>
    </div>
</div>

<div class="container">
    <div class="search-form-container mb-5">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control border-start-0 ps-0" placeholder="Czego chcesz się dziś nauczyć?" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" asp-items="@(ViewData["CategoryId"] as SelectList)" class="form-select form-select-lg" onchange="this.form.submit()">
                        <option value="">Wszystkie kategorie</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Szukaj</button>
                    <a asp-action="Index" class="btn btn-light btn-lg border">Czyść</a>
                </div>
            </div>
        </form>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5">
                <h4 class="text-muted">Niestety, nie znaleźliśmy kursów spełniających te kryteria.</h4>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/300x200?text=Brak+zdjecia" class="card-img-top" alt="Brak zdjęcia" style="height: 200px; object-fit: cover;">
                        }

                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@item.Category?.Name</span>
                            <h5 class="card-title">@item.Title</h5>

                            <p class="card-text text-muted">
                                @(item.Description != null && item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            </p>

                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 mt-3">Zobacz całą ofertę</a>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                            <small class="text-muted">👤 @item.Trainer?.FullName</small>
                            <span class="fw-bold text-success fs-5">@item.Price.ToString("C")</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>