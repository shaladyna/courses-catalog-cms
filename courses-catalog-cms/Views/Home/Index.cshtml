@model IEnumerable<courses_catalog_cms.Models.Course>

@{
    ViewData["Title"] = "Najlepsze kursy w sieci";
}

<div class="p-5 text-center bg-image rounded-3 mb-5 shadow" style="background: linear-gradient(rgba(30, 27, 75, 0.7), rgba(17, 24, 39, 0.9)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat; color: white; padding-top: 120px !important; padding-bottom: 120px !important; margin-top: -16px; margin-left: -15px; margin-right: -15px; border-radius: 0 !important;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3 shadow-sm">Zainwestuj w swoją przyszłość</h1>
        <p class="lead fs-4 mb-0 opacity-75">Odkryj setki kursów prowadzonych przez ekspertów z branży.</p>
    </div>
</div>

<div class="container">

    <div class="search-form-container mb-5">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control border-start-0 ps-0" placeholder="Czego chcesz się dziś nauczyć?" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" asp-items="@(ViewData["CategoryId"] as SelectList)" class="form-select form-select-lg" onchange="this.form.submit()">
                        <option value="">Wszystkie kategorie</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Szukaj</button>
                    <a asp-action="Index" class="btn btn-light btn-lg border">Czyść</a>
                </div>
            </div>
        </form>
    </div>
    <div id="course-catalog">
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 fade-in-up">
        @if (!Model.Any())
        {
            <div class="col-12 d-flex flex-column align-items-center justify-content-center py-5 w-100 text-center">
                <i class="bi bi-search display-1 text-muted opacity-25 mb-4"></i>
                <h4 class="text-muted fw-normal mb-4">Niestety, nie znaleźliśmy kursów spełniających te kryteria.</h4>
                <a asp-action="Index" class="btn btn-outline-primary px-4 py-2 rounded-pill fw-medium shadow-sm">
                    Pokaż wszystkie kursy
                </a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/300x200?text=Brak+zdjecia" class="card-img-top" alt="Brak zdjęcia" style="height: 200px; object-fit: cover;">
                        }

                        <div class="card-body d-flex flex-column">
                            <div>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-3 px-2 py-1">@item.Category?.Name</span>
                                <h5 class="card-title fw-bold mb-3">@item.Title</h5>

                                <p class="card-text text-muted small mb-4">
                                    @(item.Description != null && item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                </p>
                            </div>

                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100 mt-auto fw-medium">Zobacz całą ofertę</a>
                        </div>

                        <div class="card-footer bg-white border-top px-3 py-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.Trainer?.ImageUrl))
                                {
                                    <img src="@item.Trainer.ImageUrl" class="rounded-circle me-2 shadow-sm" style="width: 30px; height: 30px; object-fit: cover;" alt="Trener">
                                }
                                else
                                {
                                    <i class="bi bi-person-circle text-muted fs-4 me-2"></i>
                                }
                                <small class="text-muted fw-medium">@item.Trainer?.FullName</small>
                            </div>
                            <span class="fw-bold text-success fs-5">@item.Price.ToString("C")</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div> @if (ViewBag.TotalPages > 1)
    {
            <nav aria-label="Nawigacja stron" class="mt-5 mb-5 d-flex justify-content-center">
            <ul class="pagination pagination-lg gap-2">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill px-4 shadow-sm fw-medium border-0 text-dark" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-categoryId="@ViewData["CurrentCategory"]">
                        &laquo; Poprzednia
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link rounded-circle shadow-sm border-0 fw-bold d-flex align-items-center justify-content-center"
                           style="width: 48px; height: 48px;"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewData["CurrentSearch"]"
                           asp-route-categoryId="@ViewData["CurrentCategory"]">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill px-4 shadow-sm fw-medium border-0 text-dark" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewData["CurrentSearch"]"
                       asp-route-categoryId="@ViewData["CurrentCategory"]">
                        Następna &raquo;
                    </a>
                </li>

            </ul>
        </nav>
    }
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            document.addEventListener('click', async function (e) {

                let paginationLink = e.target.closest('.pagination a');

                if (paginationLink) {
                    e.preventDefault(); 

                    let targetUrl = paginationLink.href;
                    let catalogContainer = document.getElementById('course-catalog');

                    catalogContainer.style.opacity = '0.5';
                    catalogContainer.style.transition = 'opacity 0.3s ease';

                    try {
                        let response = await fetch(targetUrl);
                        let htmlText = await response.text();

                        let parser = new DOMParser();
                        let doc = parser.parseFromString(htmlText, 'text/html');

                        let newContent = doc.getElementById('course-catalog').innerHTML;

                        catalogContainer.innerHTML = newContent;
                        catalogContainer.style.opacity = '1';

                        window.history.pushState({}, '', targetUrl);

                        let newGrid = catalogContainer.querySelector('.fade-in-up');
                        if (newGrid) {
                            newGrid.classList.remove('fade-in-up');
                            void newGrid.offsetWidth; 
                            newGrid.classList.add('fade-in-up');
                        }

                        window.scrollTo({
                            top: catalogContainer.offsetTop - 50,
                            behavior: 'smooth'
                        });

                    } catch (error) {
                        console.error('Błąd podczas ładowania kursów:', error);
                        window.location.href = targetUrl;
                    }
                }
            });

            window.addEventListener('popstate', function () {
                window.location.reload();
            });
        });
    </script>
}