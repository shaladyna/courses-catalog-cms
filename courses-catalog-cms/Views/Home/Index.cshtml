@model IEnumerable<courses_catalog_cms.Models.Course>

@{
    ViewData["Title"] = "Strona główna";
}

<div class="text-center mb-4">
    <h1 class="display-4">Katalog Kursów</h1>
    <p class="lead">Rozwijaj swoje umiejętności z naszymi ekspertami.</p>
</div>

<form asp-action="Index" method="get" class="mb-5">
    <div class="row g-2 shadow-sm p-3 bg-light rounded">
        <div class="col-md-5">
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Czego chcesz się nauczyć? (tytuł lub opis)" />
        </div>
        <div class="col-md-5">
            <select name="categoryId" asp-items="@(ViewData["CategoryId"] as SelectList)" class="form-select" onchange="this.form.submit()">
                <option value="">-- Wszystkie kategorie --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Szukaj</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Czyść</a>
        </div>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center mt-5">
            <h4 class="text-muted">Niestety, nie znaleźliśmy kursów spełniających te kryteria.</h4>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/300x200?text=Brak+zdjecia" class="card-img-top" alt="Brak zdjęcia" style="height: 200px; object-fit: cover;">
                    }

                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text text-muted">
                            @(item.Description != null && item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                        </p>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                        <small class="text-muted">👤 @item.Trainer?.FullName</small>
                        <span class="fw-bold text-success fs-5">@item.Price.ToString("C")</span>
                    </div>
                </div>
            </div>
        }
    }
</div>