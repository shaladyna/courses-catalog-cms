@model courses_catalog_cms.Models.Trainer

@{
    ViewData["Title"] = "Szczegóły Trenera";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-info"><i class="bi bi-info-circle-fill me-2"></i>Profil Prowadzącego</h2>
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Wróć do listy
                </a>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center">

                    <!-- Duży avatar -->
                    <div class="mb-4">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullName" class="rounded-circle shadow" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center text-secondary" style="width: 150px; height: 150px; border: 4px solid #fff;">
                                <i class="bi bi-person-fill" style="font-size: 4rem;"></i>
                            </div>
                        }
                    </div>

                    <h2 class="fw-bold text-dark mb-4">@Model.FullName</h2>

                    <div class="bg-light rounded-3 p-4 border text-start">
                        <h6 class="fw-bold text-muted text-uppercase mb-3" style="font-size: 0.85rem;">Biogram</h6>
                        <p class="text-secondary mb-0" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(Model.Bio) ? "Brak dodanego biogramu." : Model.Bio)</p>
                    </div>
                </div>

                <!-- Przyciski akcji -->
                <div class="card-footer bg-white border-top p-4 d-flex gap-3">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-medium flex-grow-1 shadow-sm">
                        <i class="bi bi-pencil-fill me-2"></i> Edytuj profil
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-outline-danger fw-medium px-4 shadow-sm">
                        <i class="bi bi-trash-fill me-2"></i> Usuń
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>