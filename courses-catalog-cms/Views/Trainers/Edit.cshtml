@model courses_catalog_cms.Models.Trainer

@{
    ViewData["Title"] = "Edycja Trenera";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Nagłówek -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Edycja Profilu</h2>
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Wróć do listy
                </a>
            </div>

            <!-- Karta formularza -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="form-group mb-4">
                            <label asp-for="FullName" class="form-label fw-bold text-muted">Imię i nazwisko</label>
                            <input asp-for="FullName" class="form-control form-control-lg bg-light" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Bio" class="form-label fw-bold text-muted">Biogram (Opis)</label>
                            <textarea asp-for="Bio" class="form-control bg-light" rows="5"></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-5 p-4 bg-light rounded-3 border">
                            <label class="form-label fw-bold text-dark">Zdjęcie profilowe</label>

                            <div class="d-flex align-items-center gap-4 mt-2">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="Profilowe" class="rounded-circle shadow-sm" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #fff;" />
                                }
                                else
                                {
                                    <div class="bg-white rounded-circle border d-flex align-items-center justify-content-center text-muted" style="width: 100px; height: 100px;">
                                        <i class="bi bi-person fs-1"></i>
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <label for="imageFile" class="form-label small text-muted mb-1">Zmień zdjęcie (zostaw puste, aby zachować obecne)</label>
                                    <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                                <i class="bi bi-save me-2"></i> Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}