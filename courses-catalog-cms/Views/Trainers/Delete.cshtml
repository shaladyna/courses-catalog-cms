@model courses_catalog_cms.Models.Trainer

@{
    ViewData["Title"] = "Usuń trenera";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="bg-danger p-4 text-center text-white">
                    <i class="bi bi-person-x-fill display-4 d-block mb-2"></i>
                    <h3 class="fw-bold mb-0">Usuwanie Prowadzącego</h3>
                    <p class="mb-0 opacity-75 small">Czy chcesz usunąć tego trenera z systemu?</p>
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger shadow-sm mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Błąd operacji:</strong> @TempData["ErrorMessage"]
                        </div>
                    }
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullName" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center text-secondary shadow-sm" style="width: 80px; height: 80px;">
                                <i class="bi bi-person-fill fs-2"></i>
                            </div>
                        }
                    </div>

                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Imię i nazwisko:</h6>
                    <h4 class="fw-bold text-dark mb-4">@Model.FullName</h4>

                    <div class="alert alert-warning border-0 small text-start mb-4" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        <strong>Uwaga:</strong> Jeśli ten prowadzący jest przypisany do jakichkolwiek aktywnych kursów, system uniemożliwi jego usunięcie do czasu zmiany prowadzącego w tych kursach.
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                <i class="bi bi-trash-fill me-2"></i> Potwierdź usunięcie
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-medium">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>