@model courses_catalog_cms.Models.Category

@{
    ViewData["Title"] = "Usuń kategorię";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="bg-danger p-4 text-center text-white">
                    <i class="bi bi-tag-fill display-4 d-block mb-2"></i>
                    <h3 class="fw-bold mb-0">Usuwanie Kategorii</h3>
                    <p class="mb-0 opacity-75 small">Czy na pewno chcesz usunąć tę kategorię?</p>
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <h6 class="text-muted text-uppercase small fw-bold mb-1">Nazwa kategorii:</h6>
                    <h2 class="fw-bold text-dark mb-4">@Model.Name</h2>

                    <div class="alert alert-warning border-0 small text-start mb-4" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        <strong>Wskazówka:</strong> Przed usunięciem upewnij się, że żadne kursy nie należą do tej kategorii. Usunięcie zajętej kategorii spowoduje błąd integralności bazy danych.
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                <i class="bi bi-trash-fill me-2"></i> Usuń kategorię
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-medium">
                                Anuluj i wróć
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>