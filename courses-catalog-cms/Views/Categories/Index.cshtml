@model IEnumerable<courses_catalog_cms.Models.Category>

@{
    ViewData["Title"] = "Zarządzanie Kategoriami";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-tags-fill text-success me-2"></i> Baza Kategorii</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-medium">
            <i class="bi bi-plus-lg me-1"></i> Dodaj nową kategorię
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted">Nazwa kategorii</th>
                            <th class="px-4 py-3 text-muted text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-dark">
                                    @item.Name
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-medium px-3">Edytuj</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info fw-medium px-3">Szczegóły</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger fw-medium px-3">Usuń</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center p-5">
                    <h5 class="text-muted">Brak kategorii w bazie.</h5>
                </div>
            }
        </div>
    </div>
</div>