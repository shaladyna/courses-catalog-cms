@model courses_catalog_cms.Models.Category

@{
    ViewData["Title"] = "Szczegóły Kategorii";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-info"><i class="bi bi-info-circle-fill me-2"></i>Informacje o Kategorii</h2>
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Wróć do listy
                </a>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <h6 class="fw-bold text-muted text-uppercase mb-2">Nazwa kategorii</h6>
                    <h2 class="fw-bold text-dark mb-0">@Model.Name</h2>

                </div>

                <div class="card-footer bg-white border-top p-4 d-flex gap-3">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-medium flex-grow-1 shadow-sm">
                        <i class="bi bi-pencil-fill me-2"></i> Edytuj nazwę
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-outline-danger fw-medium px-4 shadow-sm">
                        <i class="bi bi-trash-fill me-2"></i> Usuń
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>